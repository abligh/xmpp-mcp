# ~/.config/claude-agents/NAME.env — one per agent (claude-agent@NAME).

# Where the agent works. Must already be trusted: run `claude` there once and
# accept the workspace-trust prompt.
AGENT_DIR=/home/claude/work/reviewer

# xmpp-mcp (see docs/CHANNELS.md). {session} keeps a new address per
# conversation — stable across restarts, since resume keeps the session ID;
# {agent} gives a readable one (reviewer.host1@...) that people can add.
XMPP_JID={agent}.{host}@jabber-agent.example.com
XMPP_AGENT_NAME=reviewer
XMPP_AGENT_HOST=host1
XMPP_HOST_KEY_FILE=/home/claude/.config/xmpp-mcp/host1.key
XMPP_CHANNEL_ALLOW=*@jabber-agent.example.com,*@jabber.example.com
XMPP_AUTO_JOIN=agents@conference.jabber.example.com
