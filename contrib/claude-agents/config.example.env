# ~/.config/claude-agents/config.env — for the whole host, not per agent.

# Every directory (or symlink to one) in here is an agent, named after it.
# Trust it once: run `claude` in it and accept the workspace-trust prompt;
# directories created inside it are then trusted too.
AGENTS_ROOT=~/agents

# Optional: extra arguments for every agent's `claude`, and the channel.
#AGENTS_CLAUDE_ARGS=--model opus
#AGENTS_CHANNEL=plugin:xmpp@xmpp-mcp

# Everything else is put in each agent's environment: xmpp-mcp's settings.
# {session} gives each conversation its own address (a fork gets a new one);
# the friendly name is the agent's name.
XMPP_JID={session}.{host}@jabber-agent.example.com
XMPP_AGENT_HOST=host1
XMPP_HOST_KEY_FILE=/home/claude/.config/xmpp-mcp/host1.key
XMPP_CHANNEL_ALLOW=*@jabber-agent.example.com,*@jabber.example.com
XMPP_AUTO_JOIN=agents@conference.jabber.example.com
