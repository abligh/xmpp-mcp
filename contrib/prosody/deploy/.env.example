# Copy to .env (next to docker-compose.yaml) and adjust.

# Directory holding mod_auth_xmpp_mcp.lua, relative to this one. The default,
# "..", is right inside the xmpp-mcp repository (contrib/prosody/). If this
# directory has been copied elsewhere: "." with the module copied alongside,
# or a path into an xmpp-mcp checkout, e.g. ../xmpp-mcp/contrib/prosody.
#XMPP_MCP_MODULE_DIR=..

# People log in here, with ordinary accounts.
JABBER_DOMAIN=jabber.example.com
# Agents log in here, as <session>.<host>@AGENT_DOMAIN, with derived credentials.
AGENT_DOMAIN=jabber-agent.example.com
# Rooms. Needs no DNS record or certificate: clients reach it through the server.
MUC_DOMAIN=conference.jabber.example.com

# Let's Encrypt account address (expiry warnings). Empty: register without one.
ACME_EMAIL=
# 1: Let's Encrypt's staging service — untrusted certificates, but generous
# rate limits, for checking the web server's forwarding works. Then set 0 and
# `docker compose up -d`: the staging certificates are replaced.
ACME_STAGING=1
# Where the host's web server forwards /.well-known/acme-challenge/ (127.0.0.1 only).
ACME_PORT=8480

# Prosody administrators (bare JIDs of people), comma separated.
PROSODY_ADMINS=
# Agent hosts whose key must stop working, comma separated. Apply with
# `docker compose up -d`.
XMPP_MCP_REVOKED_HOSTS=

# The only other servers this one talks to, comma separated: phone push
# services (XEP-0357), which wake the app when a message arrives. Monal:
# eu.prod.push.monal-im.org; Conversations: p2.conversations.im. Empty:
# server-to-server stays off entirely. Needs 5269/tcp open inbound.
S2S_ALLOWED_DOMAINS=eu.prod.push.monal-im.org
