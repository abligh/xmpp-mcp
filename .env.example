# --- XMPP client connection (required) -------------------------------------
# Bare JID and password of the service account the MCP server logs in as.
XMPP_JID=bot@example.com
XMPP_PASSWORD=change-me

# Connect host/port. Set XMPP_HOST only if it differs from the JID domain
# (common with Openfire/M-Link lab setups). Port defaults to 5222.
#XMPP_HOST=xmpp.example.com
#XMPP_PORT=5222

# Skip TLS certificate verification. Lab / self-signed servers ONLY.
#XMPP_TLS_INSECURE=false

# Default nickname used when joining MUC rooms.
#XMPP_NICK=xmpp-mcp

# Session establishment timeout (seconds) and inbound message buffer size.
#XMPP_CONNECT_TIMEOUT=30
#XMPP_INBOX_SIZE=500

# --- Claude Code channel / agent identity (optional) ------------------------
# Turn this server into a per-session agent that PUSHES inbound messages into
# Claude Code instead of waiting to be polled. See docs/CHANNELS.md.
#XMPP_CHANNEL=false

# XMPP_JID may be a template. Under Claude Code, build the canonical address
# from the session ID; the session's (changeable) name becomes the friendly
# name automatically:
#XMPP_JID={session}.{host}@example.com   ->  7b3e9a41-….host1@example.com
#XMPP_JID={session}@{host}               ->  one XMPP vhost per host
# Placeholders: {session}, {agent} (XMPP_AGENT_NAME), {host} (XMPP_AGENT_HOST
# or the short hostname), {fqdn}. Values are normalised into a valid JID.

# Where the Claude Code session file is read from: auto | off | <path>.
#XMPP_CLAUDE_SESSION=auto
#XMPP_CLAUDE_SESSION_POLL=10     # seconds between checks for a rename

# For agents NOT running under Claude Code: a name ({agent}, and the friendly
# name) and a stable internal ID ({session}).
#XMPP_AGENT_NAME=reviewer
#XMPP_AGENT_ID=

# Pin the friendly name (otherwise it follows the Claude session's name), and
# the host advertised to peers.
#XMPP_DISPLAY_NAME=Code Reviewer
#XMPP_AGENT_HOST=host1

# Rooms joined at startup and re-joined after a reconnect. A shared directory
# room makes every agent visible to list_agents.
#XMPP_AUTO_JOIN=agents@conference.example.com

# Who may push into the session (comma-separated fnmatch patterns over the
# sender's JID). Defaults to every account on our own domain. An ungated
# channel is a prompt-injection path — keep this tight.
#XMPP_CHANNEL_ALLOW=*@example.com,alice@partner.example

# Create the account on first login via XEP-0077 in-band registration.
# Needs a server with open registration — lab use.
#XMPP_REGISTER=false

# --- Webhook-to-XMPP relay (xmpp-webhook-relay, optional) -------------------
# A standalone per-host service: HTTP webhooks in, XMPP messages out.
#WEBHOOK_XMPP_JID=webhook@example.com
#WEBHOOK_XMPP_PASSWORD=change-me
#WEBHOOK_XMPP_HOST=xmpp.example.com
#WEBHOOK_XMPP_TLS_INSECURE=false
#WEBHOOK_HTTP_HOST=127.0.0.1
#WEBHOOK_HTTP_PORT=8788
# Caller authentication (use at least one when not bound to localhost). If
# ANY of these is set, every request must satisfy one of them — a caller
# cannot drop its provider headers to be treated as an unauthenticated
# "generic" sender.
#WEBHOOK_TOKEN=                  # any sender: Authorization: Bearer / X-Webhook-Token
#WEBHOOK_GITHUB_SECRET=          # GitHub: X-Hub-Signature-256 HMAC over the body
#WEBHOOK_GITLAB_TOKEN=           # GitLab: X-Gitlab-Token
# Fallback target when a request names none (the room wins if both are set).
#WEBHOOK_DEFAULT_ROOM=agents@conference.example.com
#WEBHOOK_DEFAULT_TO=

# Restrict which JIDs may be addressed (fnmatch patterns). Worth setting on
# any relay something untrusted can reach: posting to an unknown room creates
# it, and a GitHub signature covers the body but not the destination.
#WEBHOOK_ALLOWED_TARGETS=*@example.com,agents@conference.example.com

# Recent X-GitHub-Delivery IDs remembered, so a captured signed delivery
# cannot be replayed at another JID. 0 disables.
#WEBHOOK_DEDUPE_SIZE=512

# Cap on the outgoing message, in stanza bytes after XML escaping.
#WEBHOOK_MAX_MESSAGE_BYTES=48000

# Payload-based routing: a TOML route table (see docs/CHANNELS.md), and
# whether a JSON payload may carry its own {"xmpp": {"to"|"room": …}} target.
#WEBHOOK_ROUTES=/etc/xmpp-webhook/routes.toml
#WEBHOOK_ENVELOPE=true

# Room the relay joins to resolve friendly-name targets (to = "Reviewer").
#WEBHOOK_DIRECTORY_ROOM=agents@conference.example.com

# --- Openfire REST API admin (optional) -------------------------------------
# Leave unset to disable the of_* admin tools. Requires the Openfire
# "REST API" plugin to be installed and enabled on the server.
#OPENFIRE_BASE_URL=http://openfire.example.com:9090

# Authenticate with EITHER a shared secret key...
#OPENFIRE_SECRET_KEY=your-rest-api-secret

# ...OR an admin username + password.
#OPENFIRE_ADMIN_USER=admin
#OPENFIRE_ADMIN_PASSWORD=change-me

# Verify TLS certs on Openfire REST calls (set false for self-signed).
#OPENFIRE_VERIFY_TLS=true
